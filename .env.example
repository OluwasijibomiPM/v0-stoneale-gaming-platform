# Stellar network the app expects Freighter to use: "testnet" (default) or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Public key (G...) of the account that receives XLM/USDC payments.
# For USDC it must have a USDC trustline on the selected network.
STELLAR_TREASURY_ADDRESS=

# Secret used to sign payment quotes. At least 32 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_QUOTE_SECRET=

# Optional: XLM price in USD to use when CoinGecko is unreachable
STELLAR_XLM_USD_FALLBACK_RATE=

# Soroban contract IDs (see soroban/README.md). Testnet deployments:
NEXT_PUBLIC_STONE_REWARDS_CONTRACT=CCHSCXH2TGCIDO5HLFQLMJK7LME4ZZZWK57RZ2LMEOKLLIZ5EAJGD7PS
NEXT_PUBLIC_ACHIEVEMENTS_CONTRACT=CBMB32CQYIEAJJ56LTZNXX4Q7P4JYKQEKIVV3IPBZWJ6QZFYVWI66YLQ
NEXT_PUBLIC_TOURNAMENTS_CONTRACT=CAAT4NLDA5XRBVJEGEG6VHDMHPVYD2DHDSSNR57L22KICLIFX3Z2DXUU

# Soroban RPC endpoint. Defaults to SDF's public testnet RPC; required for mainnet.
NEXT_PUBLIC_STELLAR_RPC_URL=

# Secret key (S...) of the account that mints badges and awards STONE.
# It must be the achievements contract's issuer and the rewards contract's minter.
STELLAR_ADMIN_SECRET=
